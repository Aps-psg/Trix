{
  "canteen_system_config": {
    "system_name": "College Canteen QueueFlux Model",
    "reporting_interval_minutes": 1.0,
    "forecast_horizon_minutes": 5.0,
    "stage_a_billing": {
      "default_counters": 2,
      "nominal_service_time_minutes": 0.75,
      "service_distribution": "lognormal",
      "mu": -0.35,
      "sigma": 0.25
    },
    "stage_b_kitchen": {
      "default_resources": 3,
      "service_distribution": "lognormal",
      "sigma": 0.30,
      "categories": {
        "BEVERAGE": {
          "mean_workload_minutes": 1.2,
          "share_percentage": 35
        },
        "SNACK": {
          "mean_workload_minutes": 2.5,
          "share_percentage": 30
        },
        "MEAL": {
          "mean_workload_minutes": 5.0,
          "share_percentage": 25
        },
        "COMBO": {
          "mean_workload_minutes": 7.5,
          "share_percentage": 10
        }
      }
    },
    "decision_optimizer_weights": {
      "alpha_waiting_time": 1.0,
      "beta_congestion_penalty": 0.4,
      "gamma_operational_cost": 2.5,
      "stability_threshold": 0.60
    }
  },
  "scenarios": [
    {
      "id": "SCEN-01",
      "name": "Normal Operation",
      "condition": "NORMAL",
      "duration_minutes": 60,
      "arrival_rate_multiplier": 1.0
    },
    {
      "id": "SCEN-02",
      "name": "Lunch Rush Peak",
      "condition": "DEMAND_SURGE",
      "duration_minutes": 60,
      "arrival_rate_multiplier": 2.2,
      "surge_window": [15, 45]
    },
    {
      "id": "SCEN-03",
      "name": "POS Billing Terminal Slowdown",
      "condition": "BILLING_SLOWDOWN",
      "duration_minutes": 60,
      "slowdown_factor": 1.8,
      "slowdown_window": [20, 50]
    },
    {
      "id": "SCEN-04",
      "name": "Kitchen Deep-Fryer Resource Breakdown",
      "condition": "RESOURCE_FAILURE",
      "duration_minutes": 60,
      "inactive_counters": 1,
      "failure_window": [10, 40]
    }
  ],
  "sample_customer_trace": [
    {
      "order_id": "ORD-0001",
      "category": "BEVERAGE",
      "arrival_time": 0.45,
      "nominal_kitchen_workload": 1.2
    },
    {
