{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Simulation",
      "type": "shell",
      "command": "python queue_intelligence.py --data sample_data.json",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Launch Web Control Tower (FastAPI)",
      "type": "shell",
      "command": "python api.py",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Launch Streamlit Dashboard",
      "type": "shell",
      "command": "streamlit run app.py",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Run Tests",
      "type": "shell",
      "command": "pytest -v",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
